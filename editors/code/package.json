{
  "name": "circom-plus",
  "description": "Better circom support",
  "author": "Vu Vo",
  "license": "MIT",
  "version": "0.0.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/vuvoth/circom-plus"
  },
  "publisher": "vuvoth",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "circom",
    "ZKP"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:circom"
  ],
  "main": "./out/main",
  "contributes": {
    "languages": [
      {
        "id": "circom",
        "aliases": [
          "circom",
          "circom"
        ],
        "extensions": [
          ".circom"
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Circom LSP",
      "properties": {
        "circom-lsp.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "messages",
          "description": "Traces the communication between VS Code and the language server."
        },
        "circom-lsp.server.path": {
          "scope": "window",
          "type": "string",
          "default": "",
          "description": "Path to the ccls language server binary. If empty, uses bundled binary or searches PATH."
        }
      }
    },
    "commands": [
      {
        "command": "circom-plus.restart",
        "title": "Circom Lsp Restart"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run build-base -- --minify",
    "package": "vsce package -o circom-plus.vsix",
    "build-base": "esbuild ./src/main.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node --target=node18",
    "build": "bun run build-base -- --sourcemap",
    "watch": "bun run build-base -- --sourcemap --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ./src",
    "lint:fix": "bun run lint -- --fix",
    "typecheck": "tsc",
    "pretest": "bun run typecheck && bun run build",
    "test": "node ./out/tests/runTests.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "which": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.109.0",
    "@types/which": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vscode/test-electron": "^2.3.3",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.0",
    "ovsx": "^0.8.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.56.0"
  }
}
