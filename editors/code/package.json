{
  "name": "circom-plus",
  "description": "Better circom support",
  "author": "Vu Vo",
  "license": "MIT",
  "version": "0.0.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/vuvoth/ccls"
  },
  "publisher": "vuvoth",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "circom",
    "ZKP"
  ],
  "engines": {
    "vscode": "^1.82.0"
  },
  "activationEvents": [
    "onLanguage:circom"
  ],
  "main": "./out/extension",
  "contributes": {
    "languages": [
      {
        "id": "circom",
        "aliases": [
          "circom"
        ],
        "extensions": [
          ".circom"
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "circom-lsp",
      "properties": {
        "circom-lsp.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "messages",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    },
    "commands": [
      {
        "command": "circom-plus.restart",
        "title": "Circom Lsp Restart"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun build ./src/extension.ts --outdir=out --external=vscode --format=cjs --target=node --minify",
    "package": "vsce package -o circom-plus.vsix",
    "build": "bun build ./src/extension.ts --outdir=out --external=vscode --format=cjs --target=node --sourcemap=linked",
    "watch": "bun build ./src/extension.ts --outdir=out --external=vscode --format=cjs --target=node --sourcemap=linked --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "typecheck": "tsc",
    "verify": "bun run typecheck && bun run lint && bun run build"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "which": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20",
    "@types/vscode": "^1.82",
    "@types/which": "^3.0.4",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.0.0",
    "ovsx": "^1.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
